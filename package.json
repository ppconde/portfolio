{
	"name": "portfolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"watch": "tsc --noEmit --watch",
		"build": "tsc -b && vite build",
		"lint": "biome check --write",
		"check": "tsc && biome check && vite build && wrangler deploy --dry-run",
		"preview": "vite preview",
		"server:remote": "wrangler dev --remote",
		"server:local": "wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@react-three/drei": "^10.7.9",
		"@react-three/fiber": "^9.8.2",
		"r3f-perf": "^7.2.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"three": "^0.187.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@cloudflare/vite-plugin": "^1.67.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.187.0",
		"@vitejs/plugin-react": "^6.2.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.6",
		"wrangler": "^4.158.0"
	},
	"packageManager": "pnpm@10.30.1"
}
