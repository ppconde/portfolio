{
	"name": "portfolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"watch": "tsc --noEmit --watch",
		"build": "tsc -b && vite build",
		"lint": "exec biome check --write",
		"check": "tsc && exec biome check && vite build && wrangler deploy --dry-run",
		"preview": "vite preview",
		"server:remote": "wrangler dev --remote",
		"server:local": "wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.4.2",
		"hono": "^4.11.3",
		"leva": "^0.10.1",
		"r3f-perf": "^7.2.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"three": "^0.182.0",
		"three-stdlib": "^2.36.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@cloudflare/vite-plugin": "^1.19.0",
		"@cloudflare/workers-types": "^4.20251228.0",
		"@eslint/js": "^9.39.2",
		"@types/node": "^25.0.3",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.182.0",
		"@vitejs/plugin-react": "^5.1.2",
		"@vitejs/plugin-react-swc": "^4.2.2",
		"globals": "^17.0.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.0",
		"wrangler": "^4.56.0"
	},
	"packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
