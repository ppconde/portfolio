{
	"name": "portfolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"watch": "tsc --noEmit --watch",
		"build": "tsc -b && vite build",
		"lint": "exec biome check --write",
		"check": "tsc && exec biome check && vite build && wrangler deploy --dry-run",
		"preview": "vite preview",
		"server:remote": "wrangler dev --remote",
		"server:local": "wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@react-three/drei": "^10.7.6",
		"@react-three/fiber": "^9.4.0",
		"hono": "^4.10.4",
		"leva": "^0.10.1",
		"r3f-perf": "^7.2.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"three": "^0.181.0",
		"three-stdlib": "^2.36.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.2",
		"@cloudflare/vite-plugin": "^1.13.18",
		"@cloudflare/workers-types": "^4.20251014.0",
		"@eslint/js": "^9.39.0",
		"@types/node": "^24.9.2",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@types/three": "^0.181.0",
		"@vitejs/plugin-react": "^5.1.0",
		"@vitejs/plugin-react-swc": "^4.2.0",
		"globals": "^16.5.0",
		"typescript": "^5.9.3",
		"vite": "^7.1.12",
		"wrangler": "^4.45.3"
	},
	"packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
