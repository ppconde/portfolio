{
	"name": "portfolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"watch": "tsc --noEmit --watch",
		"build": "tsc -b && vite build",
		"lint": "exec biome check --write",
		"check": "tsc && exec biome check && vite build && wrangler deploy --dry-run",
		"preview": "vite preview",
		"server:remote": "wrangler dev --remote",
		"server:local": "wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@react-three/drei": "^10.7.3",
		"@react-three/fiber": "^9.3.0",
		"hono": "^4.9.2",
		"leva": "^0.10.0",
		"r3f-perf": "^7.2.3",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"three": "^0.179.1",
		"three-stdlib": "^2.36.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@cloudflare/vite-plugin": "^1.11.6",
		"@cloudflare/workers-types": "^4.20250816.0",
		"@eslint/js": "^9.33.0",
		"@types/node": "^24.3.0",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@types/three": "^0.179.0",
		"@vitejs/plugin-react": "^5.0.1",
		"@vitejs/plugin-react-swc": "^4.0.0",
		"globals": "^16.3.0",
		"typescript": "^5.9.2",
		"vite": "^7.1.2",
		"wrangler": "^4.30.0"
	},
