{
	"name": "portfolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"watch": "tsc --noEmit --watch",
		"build": "tsc -b && vite build",
		"lint": "exec biome check --write",
		"check": "tsc && exec biome check && vite build && wrangler deploy --dry-run",
		"preview": "vite preview",
		"server:remote": "wrangler dev --remote",
		"server:local": "wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.6.1",
		"hono": "^4.12.27",
		"leva": "^0.10.1",
		"r3f-perf": "^7.2.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"three": "^0.185.1",
		"three-stdlib": "^2.36.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@cloudflare/vite-plugin": "^1.43.0",
		"@cloudflare/workers-types": "^5.20260706.1",
		"@types/node": "^26.1.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.185.0",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitejs/plugin-react-swc": "^4.3.1",
		"globals": "^17.7.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"wrangler": "^4.107.0"
	},
	"packageManager": "pnpm@10.30.1"
}
